# =============================================================================
# AgentHub AI - Environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED for the Prisma-backed repository)
# PostgreSQL connection string. If omitted, the app runs with an in-memory
# development repository (clearly labelled, data resets on restart).
# Example (Docker): postgresql://agenthub:agenthub@localhost:5432/agenthub
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# BOT Chain Testnet (public configuration - safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BOTCHAIN_TESTNET_CHAIN_ID=968
NEXT_PUBLIC_BOTCHAIN_EXPLORER_URL=https://scan.bohr.life
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOTCHAIN_NAME=BOT Chain Testnet
NEXT_PUBLIC_BOTCHAIN_CURRENCY_SYMBOL=BOT

# -----------------------------------------------------------------------------
# BOT Chain Testnet (server-side configuration)
# -----------------------------------------------------------------------------
BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOTCHAIN_TESTNET_CHAIN_ID=968
BOTCHAIN_EXPLORER_URL=https://scan.bohr.life

# -----------------------------------------------------------------------------
# Wallet / payments
# Address that receives task payments on BOT Chain Testnet.
# On testnet a normal EOA address is fine. This is NOT a secret.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENT_RECIPIENT=

# Payment mode:
#   mock    -> clearly-labelled mock payments (development only)
#   onchain -> verify real BOT Chain testnet transactions (default)
PAYMENT_MODE=onchain

# Allow mock payments. Must be `false` whenever PAYMENT_MODE=onchain.
# Set to `true` (with PAYMENT_MODE=mock) for offline development.
ENABLE_MOCK_PAYMENT=false

# -----------------------------------------------------------------------------
# Server-side AI provider (OPTIONAL - if unset, agents run in demo mode)
# Any OpenAI-compatible chat-completions endpoint.
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Allow the clearly-labelled demo mode when no LLM_API_KEY is configured.
ENABLE_DEMO_MODE=true

# -----------------------------------------------------------------------------
# Blockchain data provider (OPTIONAL for Agent B)
# Public BOT Chain RPC is used by default (no key required). Set this only if
# you want to use an additional indexer/explorer API.
# -----------------------------------------------------------------------------
BLOCKCHAIN_DATA_API_KEY=
BLOCKCHAIN_DATA_API_URL=

# -----------------------------------------------------------------------------
# Deployed AgentMarketplace contract (OPTIONAL - set after deployment)
# -----------------------------------------------------------------------------
AGENT_MARKETPLACE_CONTRACT_ADDRESS=

# -----------------------------------------------------------------------------
# Admin API (OPTIONAL - enables operational endpoints)
# When unset, the admin endpoints respond 404 as if they do not exist.
# Requests must send a matching `x-admin-token` header. This is a SECRET.
#   POST /api/admin/agents/register   { "slug": "ai-research-assistant" }
#   POST /api/admin/tasks/:id/receipt
# -----------------------------------------------------------------------------
ADMIN_API_TOKEN=

# -----------------------------------------------------------------------------
# Hardhat deployment (server/CLI only - NEVER expose to the browser)
# -----------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Operational limits
# -----------------------------------------------------------------------------
MAX_PROMPT_CHARS=4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
