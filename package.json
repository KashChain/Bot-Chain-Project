    "receipt:sync": "tsx scripts/sync-receipts.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "clsx": "^2.1.1",
    "ethers": "^6.13.5",
    "lucide-react": "^0.474.0",
    "next": "^15.5.27",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
