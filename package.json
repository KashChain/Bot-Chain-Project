{
  "name": "agenthub-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AgentHub AI - AI Agent Marketplace on BOT Chain (Discover. Delegate. Verify.)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
