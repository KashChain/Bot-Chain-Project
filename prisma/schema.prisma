generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  DISPUTED
  REFUND_REQUESTED
  REFUNDED
}

enum ReceiptStatus {
  NONE
  SKIPPED
  PENDING
  CONFIRMED
  FAILED
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EscrowStatus {
  LOCKED
  RELEASED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  REFUNDED
  RELEASED
  REJECTED
}

enum ReportStatus {
  OPEN
  DISMISSED
  SUSPENDED
  BANNED
}

enum StakeStatus {
  ACTIVE
  UNSTAKED
}

enum PayoutStatus {
  PENDING
  PROCESSED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum CreditTxType {
  TOPUP
  SPEND
  REFUND
  ADJUSTMENT
}

model Agent {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String
  category          String
  capabilities      String[]
  usageInstructions String
  endpoint          String
  priceWei          String
  ownerAddress      String
  metadataUri       String?
  active            Boolean  @default(true)
  featured          Boolean  @default(false)
  webhookSecret     String?
  status            AgentStatus @default(ACTIVE)
  verified          Boolean  @default(false)
  notifyWebhookUrl  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tasks    Task[]
  reviews  Review[]
  reports  Report[]
  stake    Stake?

  @@index([category])
  @@index([active])
  @@index([ownerAddress])
  @@index([status])
}

model Task {
  id                 String     @id @default(cuid())
  agentId            String
  agent              Agent      @relation(fields: [agentId], references: [id])
  clientAddress      String
  input              String
  inputHash          String
  status             TaskStatus @default(CREATED)
  priceWei           String
  currency           String     @default("BOT")
  paymentTxHash      String?    @unique
  paymentVerifiedAt  DateTime?
  resultRef          String?
  resultHash         String?
  result             Json?
  error              String?
  onchainTxHash      String?
  receiptStatus      ReceiptStatus @default(NONE)
  receiptError       String?
  receiptAttempts    Int           @default(0)
  notifyEmail        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  payment       Payment?
  review        Review?
  escrow        Escrow?
  notifications NotificationDelivery[]

  @@index([clientAddress])
  @@index([status])
  @@index([agentId])
  @@index([receiptStatus])
}

model Payment {
  id          String   @id @default(cuid())
  taskId      String   @unique
  task        Task     @relation(fields: [taskId], references: [id])
  txHash      String   @unique
  chainId     Int
  fromAddress String
  toAddress   String
  amountWei   String
  status      String
  verifiedAt  DateTime @default(now())

  @@index([txHash])
}

model WalletProfile {
  address   String   @id
  label     String?
  createdAt DateTime @default(now())
}

model Review {
  id              String   @id @default(cuid())
  taskId          String   @unique
  task            Task     @relation(fields: [taskId], references: [id])
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reviewerAddress String
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([reviewerAddress])
}

model SiweNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  address   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([address])
  @@index([expiresAt])
}

model Escrow {
  id           String       @id @default(cuid())
  taskId       String       @unique
  task         Task         @relation(fields: [taskId], references: [id])
  agentId      String
  ownerAddress String
  clientAddress String
  amountWei    String
  feeBps       Int
  feeWei       String
  netWei       String
  status       EscrowStatus @default(LOCKED)
  lockTxHash    String?
  releaseTxHash String?
  refundTxHash  String?
  releasedAt   DateTime?
  refundedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([agentId])
  @@index([ownerAddress])
  @@index([clientAddress])
  @@index([status])
}

model Dispute {
  id          String        @id @default(cuid())
  taskId      String
  openedBy    String
  reason      String
  status      DisputeStatus @default(OPEN)
  note        String?
  resolvedBy  String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([taskId])
  @@index([status])
}

model Report {
  id              String       @id @default(cuid())
  agentId         String
  agent           Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reporterAddress String
  reason          String
  details         String?
  status          ReportStatus @default(OPEN)
  reviewedBy      String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  @@index([agentId])
  @@index([status])
}

model Stake {
  id           String      @id @default(cuid())
  agentId      String      @unique
  agent        Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ownerAddress String
  amountWei    String
  status       StakeStatus @default(ACTIVE)
  txHash       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ownerAddress])
  @@index([status])
}

model Payout {
  id           String       @id @default(cuid())
  ownerAddress String
  amountWei    String
  status       PayoutStatus @default(PENDING)
  txHash       String?
  createdAt    DateTime     @default(now())
  processedAt  DateTime?

  @@index([ownerAddress])
  @@index([status])
}

model NotificationDelivery {
  id        String             @id @default(cuid())
  taskId    String
  task      Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  event     String
  channel   String
  target    String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  error     String?
  payload   Json?
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@index([taskId])
  @@index([status])
}

model ApiKey {
  id           String    @id @default(cuid())
  name         String
  keyHash      String    @unique
  keyPrefix    String
  ownerAddress String
  rateLimit    Int       @default(60)
  scopes       String[]  @default([])
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerAddress])
  @@index([revokedAt])
}

model CreditBalance {
  id           String   @id @default(cuid())
  ownerAddress String   @unique
  balanceWei   String   @default("0")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerAddress])
}

model CreditTransaction {
  id              String       @id @default(cuid())
  ownerAddress    String
  type            CreditTxType
  amountWei       String
  balanceAfterWei String
  reference       String?
  createdAt       DateTime     @default(now())

  @@index([ownerAddress])
  @@index([reference])
}

model Subscription {
  id                String             @id @default(cuid())
  ownerAddress      String
  planId            String
  status            SubscriptionStatus @default(ACTIVE)
  agentId           String?
  periodStart       DateTime           @default(now())
  periodEnd         DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([ownerAddress])
  @@index([agentId])
  @@index([status])
}

model ProcessedJob {
  id          String   @id @default(cuid())
  jobId       String   @unique
  kind        String
  processedAt DateTime @default(now())

  @@index([kind])
}
