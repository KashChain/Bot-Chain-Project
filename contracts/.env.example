# Copy to contracts/.env only if you want per-workspace overrides.
# The Hardhat config also reads the repo-root .env file.

# Server/CLI only. NEVER commit a real key and never expose it to the browser.
DEPLOYER_PRIVATE_KEY=

# BOT Chain testnet RPC (defaults to the public endpoint).
BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life

# BOT Chain mainnet RPC (defaults to the public endpoint).
BOTCHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai
